{
  "name": "memkeys-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MemKeys documentation + landing site (Astro + Starlight). Docs are ingested at build time from the MemKeys/memkeys code repo's docs/ tree — see scripts/sync-docs.mjs.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "prebuild": "npm run sync",
    "build": "astro build",
    "postbuild": "node scripts/check-refs.mjs && node scripts/check-mermaid.mjs",
    "preview": "astro preview",
    "check": "npm run sync && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.34.0",
    "astro": "^5.6.0",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.48.0",
    "typescript": "^5.9.3"
  }
}