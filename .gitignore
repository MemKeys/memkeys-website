# build output
dist/
.astro/

# dependencies
node_modules/

# generated by scripts/sync-docs.mjs — docs/ is the source of truth
# (hand-authored site pages are tracked; everything else in here is generated)
src/content/docs/**/*
!src/content/docs/index.mdx
!src/content/docs/why.mdx
!src/content/docs/quickstart.mdx
# hand-authored figure wrapper (protected by sync-docs KEEP). Un-ignore the
# docs/ subdir so git can descend, then track only this one file; the synced
# siblings stay ignored (matched by the recursive pattern above).
!src/content/docs/docs/
!src/content/docs/docs/fact-flow.mdx

# misc
.DS_Store
*.local
.env
.env.*

# sparse checkout of MemKeys/memkeys docs/ (CI) — regenerated, never tracked
.memkeys/
